# ---- backend ----------------------------------------------------------------
NBA_ENV=local
NBA_DATABASE_URL=postgresql+psycopg://nba:nba@localhost:5432/nba
NBA_REDIS_URL=redis://localhost:6379/0
NBA_MODEL_DIR=models

# When no trained artefact is present, answer from the calibrated baseline model
# instead of returning 500. Set to false in production to fail loudly.
NBA_ALLOW_MOCK_INFERENCE=true

# Optional paid providers with structured JSON (both have free tiers)
# NBA_SPORTSDATAIO_KEY=
# NBA_SPORTRADAR_KEY=

# ---- frontend ---------------------------------------------------------------
# Leave unset for demo mode (fully offline). Set it to use the API above.
# VITE_API_URL=http://localhost:8000/api
